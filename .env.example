# Kopiera till .env (valfritt - allt har fornuftiga standardvarden)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ANOMALY_THRESHOLD_TURBIDITY=30   # NTU
ANOMALY_THRESHOLD_TEMPERATURE=25 # grader C
INGEST_API_KEY=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_SUBSCRIBE_TOPIC=beach/+/readings

# E-post: console lokalt; se docs/email.md för SMTP och tester.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com
PLATFORM_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_TIMEOUT=3600       # återställningslänkens giltighet i sekunder
