# Kopiera till .env i projektroten. Processens miljövariabler har företräde.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ANOMALY_THRESHOLD_TURBIDITY=30   # NTU
ANOMALY_THRESHOLD_TEMPERATURE=25 # grader C
INGEST_API_KEY=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_SUBSCRIBE_TOPIC=beach/+/readings

# E-post: fyll i SMTP-leverantörens uppgifter; se docs/email.md.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com
PLATFORM_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_TIMEOUT=3600       # återställningslänkens giltighet i sekunder
