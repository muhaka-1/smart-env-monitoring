menu "Beach Sensor"
    config BEACH_WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"
    config BEACH_WIFI_PASSWORD
        string "Wi-Fi password"
        default "mypassword"
    config BEACH_MQTT_BROKER_URI
        string "MQTT broker URI (datorns LAN-IP, inte localhost)"
        default "mqtt://192.168.1.100:1883"
    config BEACH_SENSOR_ID
        string "Sensor ID (a-z, 0-9, -, _)"
        default "esp32-beach-01-turbidity"
    config BEACH_SAMPLE_INTERVAL_MS
        int "Sample interval (ms)"
        default 5000
    config BEACH_SENSOR_SIMULATED
        bool "Simulerade matvarden (ingen riktig sensor)"
        default y
    config BEACH_ADC_CHANNEL
        int "ADC1-kanal (ESP32: 6 = GPIO34)"
        default 6
        depends on !BEACH_SENSOR_SIMULATED
    config BEACH_NTU_FULL_SCALE
        int "NTU vid full ADC-utslag (kalibrera mot din sensor)"
        default 100
        depends on !BEACH_SENSOR_SIMULATED
    config BEACH_MAX_RETRIES
        int "Max antal sandningsforsok"
        default 5
    config BEACH_RETRY_BASE_DELAY_MS
        int "Retry base delay (ms), dubbleras per forsok"
        default 1000
    config BEACH_QUEUE_LENGTH
        int "Kolangd mellan sensor- och kommunikationstask"
        default 16

    config BEACH_LIMIT_TURBIDITY_NTU
        int "Maximum turbidity (NTU)"
        range 0 1000
        default 30

    config BEACH_LIMIT_WATER_TEMP_C
        int "Maximum water temperature (C)"
        range -2 50
        default 25
endmenu
