msgstr "Readings"

msgid "Om mätvärdena"
msgstr "About the readings"

msgid "Logga in"
msgstr "Sign in"

msgid "DIN ARBETSPLATS"
msgstr "YOUR WORKSPACE"

msgid "Arbetsyta"
msgstr "Workspace"

msgid "Översikt"
msgstr "Overview"

