msgstr "The history contains different metrics and cannot be shown in the same chart."

msgid "Inga mätvärden finns för det valda intervallet."
msgstr "No readings were found for the selected range."

msgid "Gränsvärde"
msgstr "Threshold"

msgid "● OK · ▲ Avvikelse. Statusen följer projektets konfigurerade gränsregel och är inte en officiell bedömning av badvattnet."
msgstr "● OK · ▲ Anomaly. The status follows the project's configured threshold rule and is not an official assessment of the bathing water."

msgid "Tid (lokal tid)"
msgstr "Time (local time)"

msgid "Välj både Från och Till, eller använd ett snabbval."
msgstr "Select both From and To, or use a shortcut."

msgid "Tidsintervallet innehåller ett ogiltigt datum."
msgstr "The time range contains an invalid date."

msgid "Från måste vara tidigare än Till."
msgstr "From must be earlier than To."

#, python-format
msgid "Intervall: %(range)s."
msgstr "Range: %(range)s."

#, python-format
msgid "Eget intervall: %(start)s – %(end)s."
msgstr "Custom range: %(start)s – %(end)s."

msgid "Eget intervall är inte komplett."
msgstr "The custom range is incomplete."

msgid "Välj en sensor innan rapporten skapas."
msgstr "Select a sensor before creating the report."

msgid "Din session har gått ut eller saknar behörighet. Logga in igen för att visa historiken."
msgstr "Your session has expired or lacks permission. Sign in again to view history."

msgid "Mätvärdena är inte tillgängliga just nu."
msgstr "The readings are not available right now."

#, python-format
msgid "Uppdaterad %(time)s"
msgstr "Updated %(time)s"

msgid "Uppdateringen misslyckades"
msgstr "Update failed"

msgid "Kunde inte hämta nya mätvärden. Kontrollera anslutningen eller logga in igen. Ett nytt försök görs automatiskt."
msgstr "Could not retrieve new readings. Check the connection or sign in again. Another attempt will be made automatically."

msgid "Bra"
msgstr "Good"

msgid "Misstänkt"
msgstr "Suspect"

msgid "Dålig"
msgstr "Bad"

msgid "Väntar på e-postförsök"
msgstr "Waiting for email attempt"

msgid "Påbörjat utskick, utfall ännu inte bekräftat"
msgstr "Sending started, outcome not yet confirmed"

msgid "Accepterat av e-postservern"
msgstr "Accepted by the email server"

msgid "E-postförsöket misslyckades"
msgstr "Email attempt failed"

msgid "Sensor"
msgstr "Sensor"

msgid "Från (UTC)"
msgstr "From (UTC)"

msgid "Till (UTC)"
msgstr "To (UTC)"

msgid "Ange ett giltigt sensor-ID med a-z, 0-9, '-' eller '_'."
msgstr "Enter a valid sensor ID using a-z, 0-9, '-' or '_'."

msgid "Ange giltigt datum och tid i ISO 8601-format."
msgstr "Enter a valid date and time in ISO 8601 format."

msgid "Till måste vara samma tid som eller senare än Från."
msgstr "To must be the same time as or later than From."

msgid "Ingen startgräns"
msgstr "No start limit"

msgid "Ingen slutgräns"
msgstr "No end limit"

msgid "Rapportsidan finns inte."
msgstr "The report page does not exist."

msgid "BADVATTENKVALITET"
msgstr "BATHING WATER QUALITY"

msgid "En samlad bild av dina mätvärden."
msgstr "A complete view of your readings."

msgid "Logga in för att följa utvecklingen och granska plattformens sparade avvikelser."
msgstr "Sign in to follow developments and review the platform's saved anomalies."

msgid "Historiska mätningar och diagram"
msgstr "Historical readings and charts"

msgid "Dina meddelanden från systemet"
msgstr "Your system messages"

msgid "Rapporter på skärm och som PDF"
msgstr "On-screen and PDF reports"

msgid "Aktivera konto"
msgstr "Activate account"

msgid "Välj ditt lösenord för att aktivera kontot."
msgstr "Choose your password to activate the account."

msgid "Länken fungerar inte"
msgstr "The link does not work"

msgid "Inbjudningslänken är ogiltig, har gått ut eller har redan använts. Kontakta administratören för en ny inbjudan."
msgstr "The invitation link is invalid, has expired, or has already been used. Contact the administrator for a new invitation."

msgid "Kontot är aktiverat"
msgstr "The account is activated"

#, python-format
msgid "Du kan nu <a href=\"%(login_url)s\">logga in</a> med ditt användarnamn och lösenord."
msgstr "You can now <a href=\"%(login_url)s\">sign in</a> with your username and password."

msgid "Lösenordet är bytt"
msgstr "The password has been changed"

msgid "Ditt nya lösenord är sparat. Du är fortfarande inloggad på den här enheten; andra inloggade sessioner har avslutats."
msgstr "Your new password has been saved. You are still signed in on this device; other signed-in sessions have ended."

msgid "Lösenordet är ändrat"
msgstr "The password has been changed"

msgid "Ditt nya lösenord är sparat. Du kan nu logga in med det."
msgstr "Your new password has been saved. You can now sign in with it."

msgid "Välj nytt lösenord"
msgstr "Choose a new password"

msgid "Spara nytt lösenord"
msgstr "Save new password"

msgid "Återställningslänken är ogiltig, har gått ut eller har redan använts."
msgstr "The reset link is invalid, has expired, or has already been used."

msgid "Begär en ny återställningslänk"
msgstr "Request a new reset link"

msgid "Kontrollera din e-post"
msgstr "Check your email"

msgid "Om e-postadressen hör till ett aktivt konto har vi skickat en länk för att återställa lösenordet."
msgstr "If the email address belongs to an active account, we have sent a password reset link."

msgid "Länken gäller en begränsad tid och kan bara användas en gång. Kontrollera även skräpposten om inget meddelande kommer fram."
msgstr "The link is valid for a limited time and can only be used once. Also check your spam folder if no message arrives."

msgid "Tillbaka till inloggningen"
msgstr "Back to sign in"

msgid "Glömt lösenord"
msgstr "Forgot password"

msgid "Ange e-postadressen som hör till ditt konto. Om adressen finns skickar vi en länk för att välja ett nytt lösenord."
msgstr "Enter the email address associated with your account. If it exists, we will send a link to choose a new password."

msgid "Skicka återställningslänk"
msgstr "Send reset link"

msgid "DITT KONTO"
msgstr "YOUR ACCOUNT"

msgid "Öppna din översikt, historik och dina meddelanden."
msgstr "Open your overview, history, and messages."

msgid "Fel användarnamn eller lösenord. Försök igen."
msgstr "Incorrect username or password. Try again."

msgid "Användarnamn"
msgstr "Username"

msgid "Lösenord"
msgstr "Password"

msgid "Glömt lösenord?"
msgstr "Forgot password?"

msgid "Din inbjudan till Smart Environmental Monitoring"
msgstr "Your invitation to Smart Environmental Monitoring"

msgid "Återställ ditt lösenord"
msgstr "Reset your password"

msgid "Datavarning från Smart Environmental Monitoring"
msgstr "Data alert from Smart Environmental Monitoring"

msgid "Hej!"
msgstr "Hello!"

msgid "Du har bjudits in till Smart Environmental Monitoring."
msgstr "You have been invited to Smart Environmental Monitoring."

#, python-format
msgid "Ditt användarnamn är: %(username)s"
msgstr "Your username is: %(username)s"

msgid "Välj ditt lösenord via länken:"
msgstr "Choose your password using this link:"

msgid "Inbjudan gäller i högst tre dagar. Om länken har gått ut, kontakta administratören för en ny inbjudan."
msgstr "The invitation is valid for up to three days. If the link has expired, contact the administrator for a new invitation."

msgid "Hälsningar,"
msgstr "Regards,"

msgid "Du har begärt att återställa ditt lösenord till Smart Environmental Monitoring."
msgstr "You requested a password reset for Smart Environmental Monitoring."

msgid "Välj ett nytt lösenord via länken:"
msgstr "Choose a new password using this link:"

msgid "Länken gäller en begränsad tid och kan bara användas en gång."
msgstr "The link is valid for a limited time and can only be used once."

msgid "Om du inte har begärt återställningen kan du bortse från detta meddelande."
msgstr "If you did not request the reset, you can ignore this message."

msgid "En datavarning har registrerats i Smart Environmental Monitoring."
msgstr "A data alert has been registered in Smart Environmental Monitoring."

msgid "Tid"
msgstr "Time"

msgid "Statusen är projektets gränsregel, inte en myndighetsbedömning av badvattenkvalitet."
msgstr "The status is the project's threshold rule, not an official assessment of bathing water quality."

msgid "Logga in på plattformen för att läsa meddelandet:"
msgstr "Sign in to the platform to read the message:"

msgid "OK"
msgstr "OK"

