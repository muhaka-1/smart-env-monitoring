msgstr "Check the address and try again."

msgid "Du har inte åtkomst"
msgstr "You do not have access"

msgid "Logga in med ett konto som har behörighet. Om du skickade ett formulär, ladda om sidan och försök igen."
msgstr "Sign in with an authorised account. If you submitted a form, reload the page and try again."

msgid "Sidan kunde inte hittas"
msgstr "The page could not be found"

msgid "Kontrollera adressen eller gå tillbaka till startsidan."
msgstr "Check the address or return to the home page."

msgid "Ett fel har inträffat"
msgstr "An error has occurred"

msgid "Sidan kunde inte visas just nu. Försök igen om en stund."
msgstr "The page cannot be displayed right now. Try again shortly."

